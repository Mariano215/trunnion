# The build context is the repository, and target/ is larger than everything
# else in it combined. The image builds from source inside the container, so
# a host build directory would be copied in and then ignored.
target/
.git/
site/
graphify-out/

# Nothing generated by a local run belongs in an image. config/actor-key.seed
# in particular: an image carrying one would ship a signing identity every
# install shared, which is the defect `seed_published` exists to catch.
config/actor-key.seed
*.ledger/
ledger/
